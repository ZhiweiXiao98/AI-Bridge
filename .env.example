# ============================================================
# AI Bridge 环境变量配置
# 复制此文件为 .env 并填入你的实际值
#
# 所有配置项均可在 app/core/app_constants.py 中找到对应常量
# 优先级：环境变量 > app_constants.py 默认值
# ============================================================

# --- 上游 AI 网页地址（浏览器模式） ---
# 修改此值以适配你使用的 AI 网站
# 示例：https://chat.openai.com  https://claude.ai  https://poe.com
UPSTREAM_AI_URL=https://web-ai.example.com

# --- 认证配置 ---
# 默认管理员密码（首次启动时写入数据库，生产环境务必修改）
AUTH_ADMIN_PASSWORD=changeme

# --- 服务器配置 ---
# 服务器监听地址（0.0.0.0 表示所有网卡）
SERVER_HOST=0.0.0.0
# 服务器监听端口
SERVER_PORT=8765
# 本地回环地址（Client/RemoteWorker 连接 Server 用）
LOCAL_SERVER_HOST=127.0.0.1

# --- Chrome 浏览器配置 ---
# Chrome 远程调试端口（浏览器模式必需）
CHROME_PORT=9527

# --- API 模式配置 ---
# OpenAI 兼容 API 的默认 Base URL
DEFAULT_API_BASE_URL=https://api.openai.com/v1
# 默认模型名称
DEFAULT_API_MODEL=gpt-4o
# 轻量模型名称（守护进程后台任务使用）
DEFAULT_API_MODEL_LITE=gpt-4o-mini

# --- 代理配置 ---
# 默认代理地址（仅作 UI placeholder 使用）
DEFAULT_PROXY_URL=http://127.0.0.1:7890

# --- 知识库配置 ---
# 知识库向量数据库存储路径
KNOWLEDGE_DB_PATH=_knowledge_base_v2
# 嵌入模型名称（fastembed）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# --- Docker 沙箱配置 ---
# 是否启用 Docker 沙箱
SANDBOX_ENABLED=false
# Docker 镜像名称
SANDBOX_IMAGE=python:3.11-slim

# --- Mobile 客户端配置 ---
# Mobile 客户端连接的 Server 主机地址
BRIDGE_SERVER_HOST=127.0.0.1
# Mobile 客户端连接的 Server 端口
BRIDGE_SERVER_PORT=8765
# Mobile 客户端登录用户名
BRIDGE_SERVER_USER=admin

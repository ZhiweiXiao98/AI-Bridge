            "model": "gpt-4o",
            "temperature": 0.7,
            "max_output_tokens": 4096,
            "timeout": 60,
            "proxy_url": "",
            "supports_stream": true,
            "supports_tools": false,
            "supports_reasoning": false,
            "reasoning": {
                "enabled": false,
                "effort": "medium"
            }
        },
        "gemini": {
            "name": "Google Gemini",
            "provider": "gemini",
            "api_key": "YOUR_GEMINI_API_KEY_HERE",
            "base_url": "",
            "model": "gemini-2.5-flash",
            "temperature": 0.7,
            "max_output_tokens": 8192,
            "timeout": 60,
            "proxy_url": "",
            "supports_stream": true,
            "supports_tools": false,
            "supports_reasoning": false,
            "reasoning": {
                "enabled": false,
                "effort": "low"
            }
        },
        "deepseek": {
            "name": "DeepSeek",
            "provider": "openai_compatible",
            "api_key": "YOUR_DEEPSEEK_API_KEY_HERE",
            "base_url": "https://api.deepseek.com/v1",
            "model": "deepseek-chat",
            "temperature": 0.7,
            "max_output_tokens": 4096,
            "timeout": 60,
            "proxy_url": "",
            "supports_stream": true,
            "supports_tools": false,
            "supports_reasoning": false,
            "reasoning": {
                "enabled": false,
                "effort": "medium"
            }
        }
